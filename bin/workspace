#!/usr/bin/env bash
#
# workspace -- the tmux side of a git worktree.
#
# A workspace is a worktree, the window laid out for it, and whatever is running
# in that window's panes. Nothing here owns the list: git says which worktrees
# exist and tmux says which of them have a window, so this can never drift from
# what is actually on the machine.
#
#   workspace list              every worktree, and whether its window is up
#   workspace up <path>         build the window from the project's plan
#   workspace down <path>       kill it
#   workspace menu              pick one; up ones are switched to, down ones built
#   workspace created <path>    what WORKTREE_HOOK points at
#
# bash 3.2, like the rest of tmuxbar: no associative arrays, no mapfile.

set -uo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=lib/utils.sh
source "$root/lib/utils.sh"

# Where a layout lives when it cannot live in the repository it describes.
workspace_config="${XDG_CONFIG_HOME:-$HOME/.config}/workspace"

usage() {
    echo "usage: workspace {list|up <path>|down <path>|save [-f] [-g] [path]|menu|created <path>}" >&2
    exit 1
}

# --- finding worktrees ------------------------------------------------------

# Every git checkout under the projects root. Matches atrium's own scan: three
# levels deep, and the build directories are never worth descending into.
workspace_repos() {
    local projects="${ATRIUM_PROJECTS:-$HOME/projects}"
    [ -d "$projects" ] || return 0
    find "$projects" -maxdepth 3 \
        \( -name node_modules -o -name target -o -name .cargo -o -name .venv -o -name vendor \) -prune -o \
        -name .git -print 2>/dev/null |
        sed 's|/\.git$||'
}

# The path with every symlink resolved. $HOME is commonly a link -- /home into
# /var/home on an ostree machine -- and git always reports the resolved form, so
# a window bound to the unresolved one would never be found again.
workspace_abs() {
    (cd "$1" 2>/dev/null && pwd -P) || printf '%s\n' "$1"
}

# The window showing this worktree, or nothing. Server-wide on purpose: the
# sessions here are grouped, so a window belongs to the server rather than to
# whichever session is attached.
workspace_window() {
    tmux list-windows -a -F '#{window_id}|#{@workspace}' 2>/dev/null |
        awk -F'|' -v want="$1" '$2 == want { print $1; exit }'
}

# The main checkout a worktree belongs to. The first entry `worktree list`
# prints is always the main one, and it is where .workspace is looked for --
# never in the worktree, so a file that is untracked still reaches every
# worktree of the repo.
workspace_main() {
    local main
    main=$(git -C "$1" worktree list --porcelain 2>/dev/null | awk '/^worktree /{ print substr($0, 10); exit }')
    [ -n "$main" ] || return 1
    printf '%s\n' "$main"
}

# state<TAB>path<TAB>branch<TAB>project, one line per worktree, deduplicated:
# every worktree of a repo reports the same set, so each is seen many times.
workspace_list() {
    local repo path branch project state seen='' line

    while IFS= read -r repo; do
        [ -n "$repo" ] || continue
        project=$(workspace_main "$repo") || continue
        project=${project##*/}

        path=''
        while IFS= read -r line; do
            case "$line" in
            'worktree '*) path=${line#worktree } ;;
            'branch refs/heads/'*)
                branch=${line#branch refs/heads/}
                ;;
            '')
                [ -n "$path" ] || continue
                # 3.2 has no associative arrays, so the seen set is a string.
                case "$seen" in
                *"|$path|"*) ;;
                *)
                    seen="$seen|$path|"
                    state=down
                    [ -n "$(workspace_window "$path")" ] && state=up
                    printf '%s\t%s\t%s\t%s\n' "$state" "$path" "${branch:-detached}" "$project"
                    ;;
                esac
                path='' branch=''
                ;;
            esac
        done < <(
            git -C "$repo" worktree list --porcelain 2>/dev/null
            echo
        )
    done < <(workspace_repos) | sort -t"$(printf '\t')" -k4,4 -k2,2
}

# --- building a window ------------------------------------------------------

# Where this worktree's layout is written down, if anywhere.
#
# Two tiers, most specific first:
#
#   1. <main checkout>/.workspace           the repository's own
#   2. ~/.config/workspace/<project>.workspace
#
# Tier 1 is read from the MAIN checkout rather than the worktree, so a worktree
# inherits its project's layout. Tier 2 is for repositories you cannot put a
# file in -- someone else's, or one whose reset does `git clean -fdx`, which
# deletes an untracked file at the root along with everything else. It is keyed
# on the main checkout's name, so customer-portal-test finds customer-portal's.
#
# Neither: one empty window, which is no worse than the one you would have
# opened by hand.
workspace_plan_path() {
    local main candidate
    main=$(workspace_main "$1") || return 1

    candidate="$main/.workspace"
    if [ -r "$candidate" ]; then
        printf '%s\n' "$candidate"
        return 0
    fi

    candidate="$workspace_config/${main##*/}.workspace"
    if [ -r "$candidate" ]; then
        printf '%s\n' "$candidate"
        return 0
    fi
    return 1
}

# A plan is an optional `layout` line plus one line per pane:
#
#   name  from  split  size  cwd  delay  command
#
# name   what `from` refers to; never renumbers when a pane is inserted
# from   which pane to split, by name; - opens the window
# split  h or v; - for the window's own pane
# size   what the new pane takes, e.g. 40%; - lets tmux decide
# cwd    relative to the worktree root
# delay  0 to run at once, gate to be the gate, +N for N seconds after it opens
# cmd    - for a bare shell
workspace_plan() {
    local plan
    plan=$(workspace_plan_path "$1") || {
        printf '%s\n' 'window  -  -  -  .  0  -'
        return
    }
    cat "$plan"
}

# tmux's own layout string, when the plan carries one.
workspace_layout_of() {
    workspace_plan "$1" | awk '$1 == "layout" { print $2; exit }'
}

workspace_up() {
    local path win panes='' sends='' gate layout focus=''
    local name from split size cwd delay cmd target pane

    path=$(workspace_abs "$1")
    [ -d "$path" ] || {
        echo "workspace: no such directory: $path" >&2
        return 1
    }
    if [ -n "$(workspace_window "$path")" ]; then
        echo "workspace: already up: $path" >&2
        return 0
    fi

    while read -r name from split size cwd delay cmd; do
        case "$name" in '' | '#'* | layout) continue ;; esac
        [ "$cwd" = '.' ] && cwd=''

        if [ "$from" = '-' ]; then
            win=$(tmux new-window -P -F '#{window_id}' -n "${path##*/}" -c "$path${cwd:+/$cwd}")
            [ -n "$win" ] || return 1
            # Bound to the worktree here, which is the whole of how tmux knows
            # which window belongs to which workspace.
            tmux set-option -w -t "$win" @workspace "$path"
            gate="${TMPDIR:-/tmp}/workspace-gate-${win#@}"
            rm -f "$gate"
            pane=$(tmux list-panes -t "$win" -F '#{pane_id}' | head -n1)
        else
            # By name rather than by position, so inserting a pane renumbers
            # nothing. 3.2 has no associative arrays, hence the awk.
            target=$(printf '%s\n' "$panes" | awk -v want="$from" '$1 == want { print $2; exit }')
            [ -n "$target" ] || {
                echo "workspace: pane '$name' splits from '$from', which is not there" >&2
                continue
            }
            local size_arg=''
            [ "$size" != '-' ] && [ "$size" != '' ] && size_arg="-l $size"
            # shellcheck disable=SC2086
            pane=$(tmux split-window -P -F '#{pane_id}' "-$split" $size_arg -t "$target" -c "$path${cwd:+/$cwd}")
            # tmux refuses to split a pane already too small, and the empty id
            # would send the next command into whatever pane is active.
            [ -n "$pane" ] || {
                echo "workspace: no room for pane '$name'" >&2
                continue
            }
        fi

        panes="${panes}${name} ${pane}
"
        # Held rather than sent now: every pane is made first, so the whole
        # layout costs one wait for a shell instead of one per pane.
        sends="${sends}${pane}	${delay}	${cmd}
"
        # The first pane you left empty is the one you meant to type in.
        [ "$cmd" = '-' ] && [ -z "$focus" ] && focus=$pane
    done < <(workspace_plan "$path")

    [ -n "${win:-}" ] || return 1

    # Exact geometry, when the plan was captured rather than written. A stale
    # line -- a row added since -- makes tmux refuse it, and the sizes the rows
    # asked for stand instead. That is a worse layout, never a broken one.
    layout=$(workspace_layout_of "$path")
    [ -n "$layout" ] && tmux select-layout -t "$win" "$layout" 2>/dev/null

    # One wait for the panes to have a shell to type into, rather than one per
    # pane -- seventeen of those is most of a freeze on its own.
    sleep 0.5
    while IFS="$(printf '\t')" read -r pane delay cmd; do
        [ -n "$pane" ] || continue
        workspace_send "$pane" "$delay" "$cmd" "$gate"
    done <<EOF
$sends
EOF

    [ -n "$focus" ] || focus=$(printf '%s\n' "$panes" | awk 'NR == 1 { print $2 }')
    [ -n "$focus" ] && tmux select-pane -t "$focus"
}

# One pane's command, at the time the plan asked for.
workspace_send() {
    local pane=$1 delay=$2 cmd=$3 gate=$4

    [ "$cmd" = '-' ] && return 0

    case "$delay" in
    gate)
        # `;` rather than `&&`, so the gate still opens when the command fails
        # and the panes waiting on it are told rather than left hanging.
        tmux send-keys -t "$pane" "$cmd; echo \$? > '$gate'" C-m
        ;;
    +*)
        # setsid, not merely `&`. A waiter left in this script's process
        # group keeps `tmux run-shell` waiting long after the script itself
        # has exited, so opening a gated layout froze every tmux client for
        # the whole length of the install. Redirecting the three streams is
        # not enough on its own -- the new session is what releases the job.
        setsid "$0" after-gate "$pane" "${delay#+}" "$cmd" "$gate" </dev/null >/dev/null 2>&1 &
        ;;
    *)
        tmux send-keys -t "$pane" "$cmd" C-m
        ;;
    esac
}

# Wait for the gate, then run. Offsets are measured from the gate opening, not
# from when the window was built.
workspace_after_gate() {
    local pane=$1 offset=$2 cmd=$3 gate=$4 waited=0 rc

    while [ ! -f "$gate" ] && [ "$waited" -lt 1800 ]; do
        sleep 2
        waited=$((waited + 2))
    done

    rc=timeout
    [ -f "$gate" ] && rc=$(cat "$gate")
    if [ "$rc" != 0 ]; then
        tmux send-keys -t "$pane" "echo 'workspace: the gate did not succeed ($rc) -- not starting'" C-m
        return 0
    fi

    sleep "$offset"
    tmux send-keys -t "$pane" "$cmd" C-m
}

workspace_down() {
    local win
    win=$(workspace_window "$(workspace_abs "$1")")
    [ -n "$win" ] || {
        echo "workspace: no window for $1" >&2
        return 1
    }
    tmux kill-window -t "$win"
}

# --- capturing a layout -----------------------------------------------------

# Arrange a window by hand, then write it down.
#
# tmux's own layout string is what makes this exact, so no percentage is ever
# worked out -- here or by you. What it cannot give back is the command: tmux
# reports the foreground process, so a pane running `pnpm watch` reports node.
# Those are written with a note to check them.
workspace_save() {
    local force=0 general=0 path win main out layout pcmd pcwd rel cmd note name prev='' used=' ' n=0

    while :; do
        case "${1:-}" in
        -f)
            force=1
            shift
            ;;
        -g)
            general=1
            shift
            ;;
        *) break ;;
        esac
    done

    if [ "$#" -ge 1 ] && [ -n "${1:-}" ]; then
        path=$(workspace_abs "$1")
        win=$(workspace_window "$path")
    else
        win=$(tmux display-message -p '#{window_id}')
        path=$(tmux show-options -w -qv -t "$win" @workspace)
        # A window nobody bound: fall back to what the pane is standing in.
        [ -n "$path" ] || path=$(workspace_abs "$(tmux display-message -p '#{pane_current_path}')")
    fi

    [ -n "$win" ] || {
        echo "workspace: no window to save" >&2
        return 1
    }
    main=$(workspace_main "$path") || {
        echo "workspace: $path is not inside a git repository" >&2
        return 1
    }

    # -g forces the general place, for a repository you cannot leave a file in.
    # Otherwise update the plan where it already is, and failing that write the
    # repository's own.
    if [ "$general" -eq 1 ]; then
        out="$workspace_config/${main##*/}.workspace"
        mkdir -p "$workspace_config"
    else
        out=$(workspace_plan_path "$path") || out="$main/.workspace"
    fi

    if [ -e "$out" ] && [ "$force" -eq 0 ]; then
        echo "workspace: $out exists already; pass -f to overwrite it" >&2
        return 1
    fi

    layout=$(tmux display-message -p -t "$win" '#{window_layout}')

    {
        echo "# Written by \`workspace save\`."
        echo "#"
        echo "# The layout line is tmux's own and carries a checksum, so it is not one"
        echo "# to edit by hand -- rearrange the window and save again. The split and"
        echo "# size columns below are only a fallback for when it no longer fits."
        echo "layout $layout"
        echo
        echo "# name      from      split size  cwd                delay  command"

        while IFS='|' read -r pcmd pcwd; do
            n=$((n + 1))

            rel=${pcwd#"$path"}
            rel=${rel#/}
            [ -n "$rel" ] || rel=.

            case "$pcmd" in
            bash | sh | zsh | fish | dash | ksh)
                cmd='-' note=''
                name="pane$n"
                ;;
            *)
                cmd=$pcmd
                note='   # check: this is the process, not what you typed'
                name=$pcmd
                ;;
            esac
            # Two panes running the same thing would otherwise share a name.
            case "$used" in *" $name "*) name="pane$n" ;; esac
            used="$used$name "

            # The first pane opens the window; the rest chain off the one
            # before, which is a valid window even if the layout is refused.
            if [ "$n" -eq 1 ]; then
                printf '%-11s %-9s %-5s %-5s %-18s %-6s %s%s\n' "$name" '-' '-' '-' "$rel" '0' "$cmd" "$note"
            else
                printf '%-11s %-9s %-5s %-5s %-18s %-6s %s%s\n' "$name" "$prev" 'v' '-' "$rel" '0' "$cmd" "$note"
            fi
            prev=$name
        done < <(tmux list-panes -t "$win" -F '#{pane_current_command}|#{pane_current_path}')
    } >"$out"

    echo "wrote $out ($n panes)"
}

# --- the menu ---------------------------------------------------------------

# One hotkey per entry, in the order tmuxbar's theme picker uses them.
menu_keys='123456789abcdefgijklmnopqrsuvwxyz'

workspace_menu() {
    local state path branch project menu=() i=0 label mark

    while IFS="$(printf '\t')" read -r state path branch project; do
        [ -n "$path" ] || continue
        [ "$i" -ge ${#menu_keys} ] && break
        # A marker rather than a colour: display-menu has no styling per entry.
        mark='  '
        [ "$state" = up ] && mark=' ●'
        label="${path##*/}$mark  ${branch}"
        if [ "$state" = up ]; then
            menu+=("$label" "${menu_keys:$i:1}" "run-shell '$root/bin/workspace switch \"$path\"'")
        else
            # -b because building a window is slow: a plain run-shell blocks the
            # whole server until it finishes, which for a gated layout is the
            # length of an install.
            menu+=("$label" "${menu_keys:$i:1}" "run-shell -b '$root/bin/workspace up \"$path\"'")
        fi
        i=$((i + 1))
    done < <(workspace_list)

    if [ "$i" -eq 0 ]; then
        tmux display-message 'workspace: no worktrees found'
        return 0
    fi

    menu+=('')
    menu+=('close this workspace' '0' "run-shell '$root/bin/workspace down \"#{@workspace}\"'")

    tmux display-menu -T ' workspaces ' -x C -y C "${menu[@]}"
}

workspace_switch() {
    local win
    win=$(workspace_window "$(workspace_abs "$1")")
    [ -n "$win" ] || return 1
    tmux select-window -t "$win"
}

# --- the hook ---------------------------------------------------------------

# What WORKTREE_HOOK points at. atrium and guitar both run this, with the event
# and the path, whenever they make a worktree.
workspace_created() {
    local path
    path=$(workspace_abs "$1")
    # Not under tmux: nothing to tell, and that is fine.
    [ -n "${TMUX:-}" ] || return 0

    tmux set-option -g @workspaces_dirty "$(date +%s)"
    tmux display-message "workspace ${path##*/} ready -- prefix+w"
    # Without this the bar waits for status-interval, which is a minute under a
    # default tmuxbar.
    tmux refresh-client -S
}

need_path() {
    [ $# -ge 2 ] || usage
}

case "${1:-}" in
list)
    workspace_list
    ;;
up)
    need_path "$@"
    workspace_up "$2"
    ;;
down)
    need_path "$@"
    workspace_down "$2"
    ;;
save)
    shift
    workspace_save "$@"
    ;;
switch)
    need_path "$@"
    workspace_switch "$2"
    ;;
menu)
    workspace_menu
    ;;
created)
    need_path "$@"
    workspace_created "$2"
    ;;
after-gate)
    # Not a verb for you: how a gated pane re-enters this script in a session
    # of its own, so nothing is left waiting on it.
    shift
    workspace_after_gate "$@"
    ;;
*)
    usage
    ;;
esac
