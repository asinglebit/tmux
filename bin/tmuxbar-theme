#!/usr/bin/env bash
#
# Theme picker back end. The prefix+T menu is generated by tmuxbar.tmux and each
# of its entries calls "tmuxbar-theme set <name>".

set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=lib/theme.sh
source "$root/lib/theme.sh"

usage() {
    echo "usage: tmuxbar-theme {list|current|set <name>|set -}" >&2
    exit 1
}

case "${1:-}" in
list)
    tmuxbar_list_themes
    ;;
current)
    tmuxbar_active_theme
    ;;
set)
    name="${2:-}"
    [ -n "$name" ] || usage

    if [ "$name" = "-" ]; then
        # Drop the live pick so @tmuxbar-theme takes over again.
        rm -f "$tmuxbar_theme_cache"
    elif tmuxbar_theme_path "$name" >/dev/null; then
        mkdir -p "$(dirname "$tmuxbar_theme_cache")"
        printf '%s\n' "$name" >"$tmuxbar_theme_cache"
    else
        tmux display-message "tmuxbar: unknown theme '$name'"
        exit 1
    fi

    # tmuxbar.tmux rebuilds every option from scratch, so this is a full reapply.
    "$root/tmuxbar.tmux"
    tmux display-message "tmuxbar theme: $(tmuxbar_active_theme)"
    ;;
*)
    usage
    ;;
esac
