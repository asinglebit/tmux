#!/usr/bin/env bash
#
# Theme picker back end. prefix+T runs "tmuxbar-theme menu", which draws the
# menu; each of its entries calls "tmuxbar-theme set <name>".

set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=lib/theme.sh
source "$root/lib/theme.sh"
# shellcheck source=lib/ghostty.sh
source "$root/lib/ghostty.sh"

usage() {
    echo "usage: tmuxbar-theme {list|current|set <name>|set -|menu [offset]}" >&2
    exit 1
}

# One hotkey per entry; 0 is held back for the reset entry below.
menu_keys='123456789abcdefgijklmnopqrsuvwxyz'

# The menu is drawn on open rather than baked into the key binding, because how
# much of it fits is only knowable then: tmux silently refuses a menu taller
# than the client, which needs a row per entry plus two of chrome. Whatever is
# left over continues on the next page.
show_menu() {
    local offset=$1
    local names=() name height page remaining count i menu=() active marker

    while IFS= read -r name; do
        [ -n "$name" ] || continue
        names+=("$name")
    done < <(tmuxbar_list_themes)

    active="$(tmuxbar_active_theme)"
    height="$(tmux display-message -p '#{client_height}')"

    # A page holds as many themes as the client and the hotkeys both allow,
    # after reserving the separator and reset entry at the bottom.
    page=$((height - 4))
    [ "$page" -gt ${#menu_keys} ] && page=${#menu_keys}
    [ "$page" -lt 2 ] && page=2 # one theme a page, so paging still advances

    remaining=$((${#names[@]} - offset))
    if [ "$remaining" -gt "$page" ]; then
        count=$((page - 1)) # the last row carries the "more" entry
    else
        count=$remaining
    fi

    i=0
    while [ "$i" -lt "$count" ]; do
        name="${names[$((offset + i))]}"
        marker=''
        [ "$name" = "$active" ] && marker=' ●'
        menu+=("${name}${marker}" "${menu_keys:$i:1}" "run-shell '$root/bin/tmuxbar-theme set $name'")
        i=$((i + 1))
    done

    if [ $((offset + count)) -lt ${#names[@]} ]; then
        menu+=("more..." "${menu_keys:$i:1}" "run-shell '$root/bin/tmuxbar-theme menu $((offset + count))'")
    fi

    menu+=('') # horizontal rule
    menu+=('reset to config default' '0' "run-shell '$root/bin/tmuxbar-theme set -'")

    tmux display-menu -T ' theme ' -x C -y C "${menu[@]}"
}

case "${1:-}" in
list)
    tmuxbar_list_themes
    ;;
current)
    tmuxbar_active_theme
    ;;
set)
    name="${2:-}"
    [ -n "$name" ] || usage

    if [ "$name" = "-" ]; then
        # Drop the live pick so @tmuxbar-theme takes over again.
        rm -f "$tmuxbar_theme_cache"
    elif tmuxbar_theme_path "$name" >/dev/null; then
        mkdir -p "$(dirname "$tmuxbar_theme_cache")"
        printf '%s\n' "$name" >"$tmuxbar_theme_cache"
    else
        tmux display-message "tmuxbar: unknown theme '$name'"
        exit 1
    fi

    # tmuxbar.tmux rebuilds every option from scratch, so this is a full reapply.
    "$root/tmuxbar.tmux"

    # That ran in a subprocess, so load the theme again for $bg here. Only the
    # switch syncs ghostty: doing it in tmuxbar.tmux would rewrite the terminal's
    # config on every tmux server start, theme change or not.
    tmuxbar_load_theme
    tmuxbar_sync_ghostty

    tmux display-message "tmuxbar theme: $(tmuxbar_active_theme)"
    ;;
menu)
    show_menu "${2:-0}"
    ;;
*)
    usage
    ;;
esac
